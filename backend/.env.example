# ==========================================
# MedQueue Pro — Environment Configuration
# ==========================================
# Copy this file to .env and fill in your
# actual values.
#
# NEVER commit the real .env file to GitHub.
# ==========================================


# ==========================================
# SERVER
# ==========================================

PORT=5000
NODE_ENV=development

# Local frontend
CLIENT_URL=http://localhost:3000


# ==========================================
# MYSQL DATABASE
# ==========================================

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=YOUR_MYSQL_PASSWORD
DB_NAME=medqueue_pro

# Connection pool
DB_CONNECTION_LIMIT=10

# false for local MySQL
# true when connecting to Aiven MySQL
DB_SSL=false


# ==========================================
# JWT AUTHENTICATION
# ==========================================

JWT_SECRET=YOUR_LONG_RANDOM_JWT_SECRET
JWT_EXPIRES_IN=7d

JWT_REFRESH_SECRET=YOUR_LONG_RANDOM_REFRESH_SECRET
JWT_REFRESH_EXPIRES_IN=30d


# ==========================================
# BCRYPT
# ==========================================

BCRYPT_SALT_ROUNDS=12


# ==========================================
# EMAIL / NODEMAILER
# ==========================================

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=YOUR_GMAIL_APP_PASSWORD

SMTP_FROM="MedQueue Pro <your_email@gmail.com>"


# ==========================================
# CLOUDINARY
# ==========================================

CLOUDINARY_CLOUD_NAME=YOUR_CLOUDINARY_CLOUD_NAME
CLOUDINARY_API_KEY=YOUR_CLOUDINARY_API_KEY
CLOUDINARY_API_SECRET=YOUR_CLOUDINARY_API_SECRET


# ==========================================
# RATE LIMITING
# ==========================================

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200


# ==========================================
# DATABASE SEEDING
# ==========================================
# Used only when running:
# npm run seed
#
# Do not use real passwords here.

SEED_ADMIN_PASSWORD=YOUR_SEED_ADMIN_PASSWORD
SEED_DOCTOR_PASSWORD=YOUR_SEED_DOCTOR_PASSWORD
