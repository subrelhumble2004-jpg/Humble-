# ==========================================
# MedQueue Pro — Environment Configuration
# Copy this file to .env and fill in real values.
# Never commit your actual .env file.
# ==========================================

# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# MySQL Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=Humble2004
DB_NAME=medqueue_pro

# JWT
JWT_SECRET=medquepro_jwt_2026_8fk2mp9xl7qR4tN6
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=Medqueuepro_REFRESH_2026_Z8nQ5vL3sK9pW2
JWT_REFRESH_EXPIRES_IN=30d

# Bcrypt
BCRYPT_SALT_ROUNDS=12

# Nodemailer (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM="MedQueue Pro <care@medqueuepro.com>"

# Cloudinary (profile photos, doctor images)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
